+        from src.tasks.amp_loco.config.g1.env_cfgs import g1_amp_flat_aligned_env_cfg
+
+        for training_height, evaluation_height in (("upright_v2", None), ("height_only_v1", "upright_v2")):
+            cfg = g1_amp_flat_aligned_env_cfg()
