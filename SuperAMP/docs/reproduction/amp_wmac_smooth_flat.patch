+            paths = prepare_mirrored_dataset(source, output)
+            self.assertEqual(len(list(paths.root.rglob("*.npz"))), 3)
+            self.assertFalse((output/"unrelated_task").exists())
+            # Expert loaders use recursive discovery. An extra NPZ anywhere in
+            # a reused cache must therefore invalidate the entire cache.
+            inserted = output/"other_task"
+            inserted.mkdir()
+            (inserted/"unrelated.npz").write_bytes((source/"WalkandRun/fixture.npz").read_bytes())
