+    def test_recording_keeps_training_metadata_separate_from_physical_protocol_hash(self):
+        protocols, hashes, sources = [], [], []
+        with tempfile.TemporaryDirectory() as directory:
+            root = Path(directory)
+            for semantics in ("soft_v1", "hard_forward_v2"):
+                path = root / semantics
+                path.mkdir()
