+                    getattr(args, name + "_checkpoint"), eval_dir / name, args, save_data=True)
+            paths = [eval_dir / "good" / f"transitions_{mode}.npz" for mode in ("walk", "recovery")]
+            chunks, dataset_metadata = read_dataset(paths)
