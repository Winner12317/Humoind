+        snapshot = PhysicsSnapshot(env)
+        recorder = EffortRecorder(env)
+        all_arrays, summaries = {}, {}
+        sequence = [("a", "a"), ("a_repeat", "a"), ("b", "b"), ("b_repeat", "b")]
+        if args.no_repeatability:
+            sequence = [("a", "a"), ("b", "b")]
+        protocol_checks = []
